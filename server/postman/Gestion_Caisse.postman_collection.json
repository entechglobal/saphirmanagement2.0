{
  "info": {
    "name": "Gestion de Caisse — ERP Saphir",
    "_postman_id": "gestion-caisse-collection-v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All endpoints for the Gestion de Caisse module.\n\n**Setup:**\n1. Set collection variable `baseUrl` = `http://localhost:3000/api`\n2. Run the Login request — the token is saved automatically\n3. Set `caisseId` to an existing caisse ID before using item-level requests"
  },
  "variable": [
    { "key": "baseUrl",   "value": "http://localhost:3000/api", "type": "string" },
    { "key": "token",     "value": "",                          "type": "string" },
    { "key": "caisseId",  "value": "1",                         "type": "string" },
    { "key": "labelId",   "value": "1",                         "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [

    {
      "name": "0 — Auth",
      "item": [
        {
          "name": "Login (saves token automatically)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Token saved:', res.token.substring(0, 30) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@saphir.ma\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },

    {
      "name": "1 — Caisses (CRUD)",
      "item": [
        {
          "name": "GET all caisses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caisse?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["caisse"],
              "query": [
                { "key": "page",      "value": "1" },
                { "key": "limit",     "value": "20" },
                { "key": "keyword",   "value": "",  "disabled": true, "description": "Search by name" },
                { "key": "societeId", "value": "1", "disabled": true, "description": "Filter by société" }
              ]
            }
          }
        },
        {
          "name": "GET my caisse",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caisse/me",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "me"]
            }
          }
        },
        {
          "name": "GET caisse by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caisse/{{caisseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "{{caisseId}}"]
            }
          }
        },
        {
          "name": "POST create caisse (for another user — admin only)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 5,\n  \"initialBalance\": 1000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caisse",
              "host": ["{{baseUrl}}"],
              "path": ["caisse"]
            }
          }
        },
        {
          "name": "POST create MY caisse (self-setup)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initialBalance\": 5000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caisse/me",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "me"]
            }
          }
        },
        {
          "name": "PUT update caisse",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Caisse Principale\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caisse/{{caisseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "{{caisseId}}"]
            }
          }
        },
        {
          "name": "DELETE caisse",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/caisse/{{caisseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "{{caisseId}}"]
            }
          }
        }
      ]
    },

    {
      "name": "2 — Opérations (Charge / Retrait / Dépôt)",
      "item": [
        {
          "name": "POST Charge — dépense sur ma caisse",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"labelId\": 1,\n  \"amount\": 250.00,\n  \"note\": \"Achat fournitures bureau\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caisse/charge",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "charge"]
            }
          }
        },
        {
          "name": "POST Retrait — source caisse → ma caisse (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceCaisseId\": 3,\n  \"amount\": 500.00,\n  \"note\": \"Retrait fin de journée\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caisse/retrait",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "retrait"]
            }
          }
        },
        {
          "name": "POST Dépôt — ma caisse → destination caisse (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destinationCaisseId\": 3,\n  \"amount\": 300.00,\n  \"note\": \"Approvisionnement caisse utilisateur\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caisse/depot",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "depot"]
            }
          }
        },
        {
          "name": "GET transferable caisses (admin — pour Retrait/Dépôt)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caisse/transferable?limit=100",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "transferable"],
              "query": [
                { "key": "societeId", "value": "1",   "disabled": true, "description": "Super Admin: filter by société" },
                { "key": "search",    "value": "Ali", "disabled": true, "description": "Search by user name" },
                { "key": "limit",     "value": "100" }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "3 — Transactions",
      "item": [
        {
          "name": "GET all transactions (global — toutes les caisses)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caisse/transactions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "transactions"],
              "query": [
                { "key": "page",      "value": "1" },
                { "key": "limit",     "value": "20" },
                { "key": "direction", "value": "in",                       "disabled": true, "description": "in | out" },
                { "key": "dateFrom",  "value": "2025-01-01T00:00:00.000Z", "disabled": true },
                { "key": "dateTo",    "value": "2025-12-31T23:59:59.999Z", "disabled": true },
                { "key": "userId",    "value": "2",                        "disabled": true, "description": "Filter by user" },
                { "key": "roleId",    "value": "3",                        "disabled": true, "description": "Filter by role (3=Caissier)" }
              ]
            }
          }
        },
        {
          "name": "GET transactions — caisse spécifique",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caisse/{{caisseId}}/transactions?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "{{caisseId}}", "transactions"],
              "query": [
                { "key": "page",      "value": "1" },
                { "key": "limit",     "value": "20" },
                { "key": "direction", "value": "out", "disabled": true },
                { "key": "dateFrom",  "value": "",    "disabled": true },
                { "key": "dateTo",    "value": "",    "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET dashboard — caisse spécifique",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caisse/{{caisseId}}/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["caisse", "{{caisseId}}", "dashboard"],
              "query": [
                { "key": "dateFrom", "value": "2025-01-01T00:00:00.000Z", "disabled": true },
                { "key": "dateTo",   "value": "2025-12-31T23:59:59.999Z", "disabled": true }
              ]
            }
          }
        }
      ]
    },

    {
      "name": "4 — Libellés de Dépense",
      "item": [
        {
          "name": "GET all libellés",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/caisse-labels?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["caisse-labels"],
              "query": [
                { "key": "page",    "value": "1" },
                { "key": "limit",   "value": "20" },
                { "key": "keyword", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "POST create libellé",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fournitures de bureau\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caisse-labels",
              "host": ["{{baseUrl}}"],
              "path": ["caisse-labels"]
            }
          }
        },
        {
          "name": "PUT update libellé",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carburant\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/caisse-labels/{{labelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["caisse-labels", "{{labelId}}"]
            }
          }
        },
        {
          "name": "DELETE libellé",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/caisse-labels/{{labelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["caisse-labels", "{{labelId}}"]
            }
          }
        }
      ]
    }

  ]
}
