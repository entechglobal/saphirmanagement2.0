  reglements            ReglementClient[]
  reglementsFournisseur ReglementFournisseur[]
  caisses               Caisse[]
  bonLivraisons         BonLivraison[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("banques")
