// ========================================
// PACK (Virtual Product Bundle — PER SOCIETE)
// ========================================

model Pack {
  id                    Int      @id @default(autoincrement())
  societeId             Int      @map("societe_id")
  barcode               String   @unique @db.VarChar(50)
  name                  String   @db.VarChar(255)
  coutRevient           Decimal  @map("cout_revient") @db.Decimal(10, 2)
  tauxMarge             Decimal  @map("taux_marge") @db.Decimal(5, 2)
  montantVenteArticles  Decimal  @map("montant_vente_articles") @db.Decimal(10, 2)
  remise                Decimal  @default(0) @db.Decimal(5, 2)
  prixVentePack         Decimal  @map("prix_vente_pack") @db.Decimal(10, 2)
  purchasePrice         Decimal  @default(0) @map("purchase_price") @db.Decimal(10, 2)
  commission            Decimal  @default(0) @db.Decimal(10, 2)
  active                Boolean  @default(true)

  societe    Societe         @relation(fields: [societeId], references: [id], onDelete: Cascade)
  components PackComponent[]
  packLines    BonLivraisonPackLine[]
  brcPackLines BonRetourClientPackLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([societeId])
  @@index([barcode])
  @@index([active])
  @@map("packs")
}

model PackComponent {
  id         Int    @id @default(autoincrement())
  packId     Int    @map("pack_id")
  articleId  Int?   @map("article_id")
  variantId  Int?   @map("variant_id")
  quantity   Decimal @db.Decimal(10, 3)
  priceField String  @default("prixVente1") @map("price_field") @db.VarChar(20)

  pack    Pack            @relation(fields: [packId], references: [id], onDelete: Cascade)
  article Article?        @relation(fields: [articleId], references: [id], onDelete: Restrict)
  variant ArticleVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([packId, articleId])
  @@unique([packId, variantId])
  @@index([packId])
  @@index([articleId])
  @@index([variantId])
  @@map("pack_components")
}

// ========================================
// BON RETOUR CLIENT PACK LINE
// ========================================

model BonRetourClientPackLine {
  id                Int     @id @default(autoincrement())
  bonRetourClientId Int     @map("bon_retour_client_id")
  packId            Int     @map("pack_id")
  quantity          Decimal @db.Decimal(10, 3)
  prixVente         Decimal @map("prix_vente") @db.Decimal(10, 2)

  bonRetourClient BonRetourClient @relation(fields: [bonRetourClientId], references: [id], onDelete: Cascade)
  pack            Pack            @relation(fields: [packId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bonRetourClientId, packId])
  @@index([bonRetourClientId])
  @@index([packId])
  @@map("bon_retour_client_pack_lines")
}

// ========================================
// BON LIVRAISON PACK LINE (Pack lines on Advanced BonLivraison)
// ========================================

model BonLivraisonPackLine {
  id             Int     @id @default(autoincrement())
  bonLivraisonId Int     @map("bon_livraison_id")
  packId         Int     @map("pack_id")
  quantity       Decimal @db.Decimal(10, 3)
  prixVente      Decimal @map("prix_vente") @db.Decimal(10, 2)
  commission     Decimal @default(0) @db.Decimal(10, 2)

  bonLivraison BonLivraison @relation(fields: [bonLivraisonId], references: [id], onDelete: Cascade)
  pack         Pack         @relation(fields: [packId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bonLivraisonId, packId])
  @@index([bonLivraisonId])
  @@index([packId])
  @@map("bon_livraison_pack_lines")
}

// ================================================================
//  DOCUMENT ARCHITECTURE — GENERIC HEADER + SPECIALIZED EXTENSION
// ================================================================
//
//  Pattern: Class Table Inheritance (shared PK)
//
//  Header record is created first.
//  Specialized record is created second, using the SAME id.
//  Lines always belong to the header for uniform queries.
//
//  Client workflow FK chain (child holds FK to parent):
//    Devis <- Commande <- BonLivraison <- Facture <- Avoir
//                              ^
//                        BonRetourClient (parallel path, physical return)
//                              |
//                           Avoir (can reference BonRetourClient)
//
//  Fournisseur workflow FK chain:
//    BonReception <- BonRetourFournisseur
//         ^
//    AvoirFournisseur (can reference BonRetourFournisseur)
//
// ================================================================

// ----------------------------------------
// CLIENT DOCUMENT — GENERIC HEADER
// ----------------------------------------

model ClientDocument {
  id             Int            @id @default(autoincrement())
  societeId      Int            @map("societe_id")
  clientId       Int?           @map("client_id")
  clientName     String?        @map("client_name") @db.VarChar(255)
  documentNumber String         @map("document_number") @db.VarChar(50)
  status         DocumentStatus @default(DRAFT)

  totalHT    Decimal @map("total_ht") @db.Decimal(10, 2)
  totalTVA   Decimal @map("total_tva") @db.Decimal(10, 2)
  totalTTC   Decimal @map("total_ttc") @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(5, 2)
  amountPaid Decimal @default(0) @map("amount_paid") @db.Decimal(10, 2)
  amountDue  Decimal @map("amount_due") @db.Decimal(10, 2)

  notes         String? @db.Text
  internalNotes String? @map("internal_notes") @db.Text
  createdBy     Int?    @map("created_by")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)
  user    User?   @relation("ClientDocCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  lines ClientDocumentLine[]

  // Specialized extension — exactly ONE will be populated per record
  devis             Devis?
  commande          Commande?
  bonLivraison      BonLivraison?
  bonRetourClient   BonRetourClient?   // NEW: physical client return
  facture           Facture?
  avoir             Avoir?             // financial credit to client

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([societeId, documentNumber])
  @@index([societeId])
  @@index([clientId])
  @@index([status])
  @@index([createdBy])
  @@map("client_documents")
}

// ----------------------------------------
// CLIENT DOCUMENT LINE
// ----------------------------------------

model ClientDocumentLine {
  id         Int @id @default(autoincrement())
  documentId Int @map("document_id")

  articleId Int? @map("article_id")
  variantId Int? @map("variant_id")

  lineNumber  Int     @map("line_number")
  description String  @db.VarChar(255)
  quantity    Decimal @db.Decimal(10, 3)

  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  remise     Decimal? @map("remise") @db.Decimal(10, 2)     // discount value
  priceField String?  @map("price_field") @db.VarChar(20)   // prixVente1 | prixVente2 | prixVente3
  commission Decimal  @default(0) @db.Decimal(10, 2)        // per-unit commercial commission snapshot

  totalHT  Decimal? @map("total_ht") @db.Decimal(12, 2)
  tvaRate  Decimal? @map("tva_rate") @db.Decimal(5, 2)
  totalTVA Decimal? @map("total_tva") @db.Decimal(12, 2)
  totalTTC Decimal? @map("total_ttc") @db.Decimal(12, 2)

  document ClientDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  article  Article?        @relation(fields: [articleId], references: [id], onDelete: Restrict)
  variant  ArticleVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([documentId, lineNumber])
  @@index([documentId])
  @@index([articleId])
  @@index([variantId])
  @@map("client_document_lines")
}

// ----------------------------------------
// FOURNISSEUR DOCUMENT — GENERIC HEADER
// ----------------------------------------

model FournisseurDocument {
  id             Int            @id @default(autoincrement())
  societeId      Int            @map("societe_id")
  fournisseurId  Int            @map("fournisseur_id")
  documentNumber String         @map("document_number") @db.VarChar(50)
  status         DocumentStatus @default(DRAFT)

  totalHT    Decimal @map("total_ht") @db.Decimal(10, 2)
  totalTVA   Decimal @map("total_tva") @db.Decimal(10, 2)
  totalTTC   Decimal @map("total_ttc") @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(5, 2)
  amountPaid Decimal @default(0) @map("amount_paid") @db.Decimal(10, 2)
  amountDue  Decimal @map("amount_due") @db.Decimal(10, 2)

  notes         String? @db.Text
  internalNotes String? @map("internal_notes") @db.Text
  createdBy     Int?    @map("created_by")

  societe     Societe     @relation(fields: [societeId], references: [id], onDelete: Cascade)
  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
  user        User?       @relation("FournisseurDocCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  lines FournisseurDocumentLine[]

  // Specialized extension — exactly ONE will be populated per record
  commandeFournisseur  CommandeFournisseur?   // purchase order (no stock)
  bonReception         BonReception?
  bonRetourFournisseur BonRetourFournisseur?  // physical return to supplier
  avoirFournisseur     AvoirFournisseur?      // NEW: financial credit from supplier

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([societeId, documentNumber])
  @@index([societeId])
  @@index([fournisseurId])
  @@index([status])
  @@index([createdBy])
  @@map("fournisseur_documents")
}

// ----------------------------------------
// FOURNISSEUR DOCUMENT LINE
// ----------------------------------------

model FournisseurDocumentLine {
  id         Int @id @default(autoincrement())
  documentId Int @map("document_id")

  articleId Int? @map("article_id")
  variantId Int? @map("variant_id")

  lineNumber  Int     @map("line_number")
  description String  @db.VarChar(255)
  quantity    Decimal @db.Decimal(10, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)

  // Nullable: BonRetourFournisseur lines may omit financials
  discount Decimal? @db.Decimal(5, 2)
  totalHT  Decimal? @map("total_ht") @db.Decimal(10, 2)
  tvaRate  Decimal? @map("tva_rate") @db.Decimal(5, 2)
  totalTVA Decimal? @map("total_tva") @db.Decimal(10, 2)
  totalTTC Decimal? @map("total_ttc") @db.Decimal(10, 2)

  document FournisseurDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  article  Article?            @relation(fields: [articleId], references: [id], onDelete: Restrict)
  variant  ArticleVariant?     @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([documentId, lineNumber])
  @@index([documentId])
  @@index([articleId])
  @@index([variantId])
  @@map("fournisseur_document_lines")
}

// ================================================================
//  SPECIALIZED DOCUMENT TABLES
//  Each uses SAME id as its parent header (shared PK / true 1:1).
//  Contains ONLY type-specific fields.
//  Holds workflow FK pointing to its upstream parent.
// ================================================================

// ----------------------------------------
// DEVIS (Quote)
// Workflow: ROOT -> Commande
// ----------------------------------------
model Devis {
  id Int @id

  documentDate  DateTime       @map("document_date") @db.Date
  validUntil    DateTime?      @map("valid_until") @db.Date
  paymentMethod PaymentMethod? @map("payment_method")
  remiseGlobale Decimal?       @map("remise_globale") @db.Decimal(5, 2)
  conditions    String?        @db.Text

  document  ClientDocument @relation(fields: [id], references: [id], onDelete: Cascade)
  commandes Commande[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([validUntil])
  @@map("devis")
}

// ----------------------------------------
// COMMANDE (Sales Order)
// Workflow: Devis -> COMMANDE -> BonLivraison
// ----------------------------------------
model Commande {
  id Int @id

  documentDate        DateTime       @map("document_date") @db.Date
  dateConfirmation    DateTime?      @map("date_confirmation") @db.Date
  dateLivraisonPrevue DateTime?      @map("date_livraison_prevue") @db.Date
  paymentMethod       PaymentMethod? @map("payment_method")
  conditionsPaiement  String?        @map("conditions_paiement") @db.VarChar(255)

  devisId Int?   @map("devis_id")
  devis   Devis? @relation(fields: [devisId], references: [id], onDelete: SetNull)

  document      ClientDocument @relation(fields: [id], references: [id], onDelete: Cascade)
  bonLivraisons BonLivraison[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([devisId])
  @@map("commandes")
}

// ----------------------------------------
// BON LIVRAISON (Delivery Note)
// Workflow: Commande -> BON_LIVRAISON -> Facture
// Stock:    OUTBOUND — stock decreases at depotId
// ----------------------------------------
model BonLivraison {
  id Int @id

  documentDate  DateTime       @map("document_date")  @db.DateTime
  dateLivraison DateTime       @map("date_livraison") @db.DateTime
  depotId       Int?           @map("depot_id")
  deliveryId    Int?           @map("delivery_id")

  commandeId Int?      @map("commande_id")
  commande   Commande? @relation(fields: [commandeId], references: [id], onDelete: SetNull)

  // STANDARD BL created when an ADVANCED order is marked PREPARE
  sourceOrderId Int?          @map("source_order_id")
  sourceOrder   BonLivraison? @relation("BLFromOrder", fields: [sourceOrderId], references: [id], onDelete: SetNull)
  preparedBls   BonLivraison[] @relation("BLFromOrder")

  // ── Advanced BonLivraison (workflow-driven) fields ──────────────
  type            BonLivraisonType   @default(STANDARD)
  commandStatus   BonLivraisonStatus? @map("command_status")

  agenceId        Int?    @map("agence_id")
  heureLivraison  String? @map("heure_livraison") @db.VarChar(10)
  telephone       String? @db.VarChar(20)
  whatsapp        String? @db.VarChar(20)
  ville           String? @db.VarChar(100)
  localisation    String? @db.Text
  withFacture     Boolean @default(false) @map("with_facture")
  raisonSocial    String? @map("raison_social") @db.VarChar(255)
  ice             String? @db.VarChar(15)
  siegeSocial     String? @map("siege_social") @db.VarChar(255)
  nombreDeColis   Int?    @map("nombre_de_colis")
  observation     String? @db.Text
  modeReglement   ModeReglement? @map("mode_reglement")
  banqueId        Int?           @map("banque_id")

  commercialId    Int? @map("commercial_id")
  preparateurId   Int? @map("preparateur_id")
  livreurId       Int? @map("livreur_id")
  totalCommission Decimal @default(0) @map("total_commission") @db.Decimal(12, 2)

  // ── REPORTE (parallel operational condition) ────────────────────
  // REPORTE is NOT a lifecycle state — it's a temporary postponement.
  // commandStatus stays unchanged while isReported = true.
  isReported       Boolean   @default(false) @map("is_reported")
  reportedAt       DateTime? @map("reported_at")
  reportedById     Int?      @map("reported_by")
  reportReason     String?   @map("report_reason") @db.VarChar(500)
  nextDeliveryDate DateTime? @map("next_delivery_date") @db.Date

  // Suspension toggle — blocks transitionStatus while true
  isSuspended Boolean @default(false) @map("is_suspended")

  // External colis (parcel) sync — Ameex / future providers
  colisTrackingNumber String?   @map("colis_tracking_number") @db.VarChar(100)
  colisProvider       String?   @map("colis_provider")        @db.VarChar(50)
  colisSync           ColisSync @default(NOT_APPLICABLE)      @map("colis_sync")
  providerConfigId    Int?      @map("provider_config_id")
  // ── End advanced fields ────────────────────────────────────────

  document         ClientDocument @relation(fields: [id], references: [id], onDelete: Cascade)
  depot            Depot?         @relation(fields: [depotId], references: [id], onDelete: SetNull)
  delivery         Delivery?      @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  agence           Agence?        @relation(fields: [agenceId], references: [id], onDelete: SetNull)
  commercial       User?          @relation("BLCommercial", fields: [commercialId], references: [id], onDelete: SetNull)
  preparateur      User?          @relation("BLPreparateur", fields: [preparateurId], references: [id], onDelete: SetNull)
  livreur          Delivery?      @relation("BLLivreur", fields: [livreurId], references: [id], onDelete: SetNull)
  reportedBy       User?                   @relation("BLReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  providerConfig   DeliveryProviderConfig? @relation("BLProviderConfig", fields: [providerConfigId], references: [id], onDelete: SetNull)
  banque           Banque?                 @relation(fields: [banqueId], references: [id], onDelete: SetNull)

  factures         Facture[]
  bonRetourClients BonRetourClient[]  // client returns referencing this delivery
  stockTransactions StockTransaction[]
  packLines        BonLivraisonPackLine[]
  statusHistory    BonLivraisonStatusHistory[]

  // Many-to-many link to advances (avances) that pay this BL
  advances BonLivraisonAdvance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([commandeId])
  @@index([sourceOrderId])
  @@index([depotId])
  @@index([deliveryId])
  @@index([type])
  @@index([commandStatus])
  @@index([agenceId])
  @@index([commercialId])
  @@index([preparateurId])
  @@index([livreurId])
  @@index([isReported])
  @@index([banqueId])
  @@map("bon_livraisons")
}

// ----------------------------------------
// BON LIVRAISON ↔ ADVANCE (Join Table)
// Tracks which advances partially/fully pay a BonLivraison
// and how much each advance contributed.
// ----------------------------------------
model BonLivraisonAdvance {
  id              Int @id @default(autoincrement())
  bonLivraisonId  Int @map("bon_livraison_id")
  advanceId       Int @map("advance_id")
  amountApplied   Decimal @map("amount_applied") @db.Decimal(10, 2)

  bonLivraison BonLivraison    @relation(fields: [bonLivraisonId], references: [id], onDelete: Cascade)
  advance      ReglementClient @relation(fields: [advanceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bonLivraisonId, advanceId])
  @@index([advanceId])
  @@map("bon_livraison_advances")
}

// ----------------------------------------
// AMEEX WEBHOOK LOG
// Append-only store of every inbound Ameex webhook. The worker
// reads PENDING rows, processes them, and stamps status.
// ----------------------------------------
model AmeexWebhookLog {
  id           Int              @id @default(autoincrement())
  trackingCode String           @map("tracking_code") @db.VarChar(100)
  ameexStatus  String           @map("ameex_status")  @db.VarChar(50)
  rawPayload   Json             @map("raw_payload")
  status       WebhookLogStatus @default(PENDING)
  processedAt  DateTime?        @map("processed_at")
  error        String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([trackingCode])
  @@index([status])
  @@map("ameex_webhook_logs")
}

// ----------------------------------------
// BON LIVRAISON STATUS HISTORY
// Append-only audit log of every commandStatus transition.
// `BonLivraison.commandStatus` holds the current state;
// this table holds the full historical trail for the stepper,
// audit, and analytics (time-per-stage, delays, performance).
// ----------------------------------------
model BonLivraisonStatusHistory {
  id        Int                @id @default(autoincrement())
  bonId     Int                @map("bon_id")
  status    BonLivraisonStatus
  note      String?            @db.VarChar(500)
  userId    Int?               @map("user_id")
  createdAt DateTime           @default(now()) @map("created_at")

  bonLivraison BonLivraison @relation(fields: [bonId], references: [id], onDelete: Cascade)
  user         User?        @relation("BLStatusHistoryUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([bonId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("bon_livraison_status_history")
}

// ----------------------------------------
// BON RETOUR CLIENT (Client Return Note) — NEW
// Workflow: BonLivraison -> BON_RETOUR_CLIENT -> Avoir (optional)
// Stock:    RETURN_IN — goods come back, stock INCREASES at depotId
// ----------------------------------------
model BonRetourClient {
  id Int @id

  documentDate DateTime  @map("document_date")  @db.DateTime
  dateRetour   DateTime? @map("date_retour") @db.Date
  depotId      Int?      @map("depot_id")  // Destination depot — stock comes back here
  motifRetour  String?   @map("motif_retour") @db.VarChar(500)

  // Upstream — which delivery is being returned
  // Nullable: a return can exist without linking to a specific BonLivraison
  bonLivraisonId Int?          @map("bon_livraison_id")
  bonLivraison   BonLivraison? @relation(fields: [bonLivraisonId], references: [id], onDelete: SetNull)

  document ClientDocument @relation(fields: [id], references: [id], onDelete: Cascade)
  depot    Depot?         @relation(fields: [depotId], references: [id], onDelete: SetNull)

  // Downstream — credit note(s) issued following this physical return
  avoirs            Avoir[]
  stockTransactions StockTransaction[]
  packLines         BonRetourClientPackLine[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([bonLivraisonId])
  @@index([depotId])
  @@map("bon_retour_clients")
}

// ----------------------------------------
// FACTURE (Invoice)
// Workflow: BonLivraison -> FACTURE -> Avoir
// Financial: triggers Payment records (we receive money)
// ----------------------------------------
model Facture {
  id Int @id

  documentDate       DateTime       @map("document_date") @db.Date
  dateEcheance       DateTime?      @map("date_echeance") @db.Date
  paymentMethod      PaymentMethod? @map("payment_method")
  penalitesRetard    Decimal?       @map("penalites_retard") @db.Decimal(5, 2)
  conditionsPaiement String?        @map("conditions_paiement") @db.VarChar(255)

  bonLivraisonId Int?          @map("bon_livraison_id")
  bonLivraison   BonLivraison? @relation(fields: [bonLivraisonId], references: [id], onDelete: SetNull)

  document ClientDocument @relation(fields: [id], references: [id], onDelete: Cascade)

  avoirs   Avoir[]
  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([dateEcheance])
  @@index([bonLivraisonId])
  @@map("factures")
}

// ----------------------------------------
// AVOIR (Credit Note — Client side)
// Workflow: Facture -> AVOIR  (financial trigger)
//           BonRetourClient -> AVOIR  (physical trigger, optional)
// Stock:    NO stock impact — use BonRetourClient for that
// Financial: triggers negative Payment (refund/credit to client)
//
// An Avoir can be:
//   a) Purely financial (price correction, discount) — factureId only
//   b) Linked to a physical return — bonRetourClientId set
//   c) Both (the most common case)
// ----------------------------------------
model Avoir {
  id Int @id

  documentDate  DateTime       @map("document_date") @db.Date
  motif         String?        @db.VarChar(500)
  paymentMethod PaymentMethod? @map("payment_method")

  // Upstream — the invoice being credited (nullable: avoir can be standalone)
  factureId Int?     @map("facture_id")
  facture   Facture? @relation(fields: [factureId], references: [id], onDelete: SetNull)

  // Optional link to the physical return that triggered this credit
  bonRetourClientId Int?             @map("bon_retour_client_id")
  bonRetourClient   BonRetourClient? @relation(fields: [bonRetourClientId], references: [id], onDelete: SetNull)

  document ClientDocument @relation(fields: [id], references: [id], onDelete: Cascade)

  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([factureId])
  @@index([bonRetourClientId])
  @@map("avoirs")
}

// ----------------------------------------
// COMMANDE FOURNISSEUR (Purchase Order)
// Workflow: ROOT -> BonReception (optional downstream)
// Stock:    NO stock impact — quantity request only (mirrors sales Commande)
// ----------------------------------------
model CommandeFournisseur {
  id Int @id

  documentDate        DateTime  @map("document_date") @db.Date
  dateLivraisonPrevue DateTime? @map("date_livraison_prevue") @db.Date
  conditionsPaiement  String?   @map("conditions_paiement") @db.VarChar(255)

  document FournisseurDocument @relation(fields: [id], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@map("commande_fournisseurs")
}

// ----------------------------------------
// BON RECEPTION (Goods Receipt)
// Workflow: ROOT -> BonRetourFournisseur
// Stock:    INBOUND — stock INCREASES at depotId
// Financial: triggers Payment records (we pay supplier)
// ----------------------------------------
model BonReception {
  id Int @id

  documentDate      DateTime @map("document_date") @db.Date
  dateReception     DateTime? @map("date_reception")  @db.DateTime
  depotId           Int?      @map("depot_id")
  documentReference String    @map("document_reference") @db.VarChar(100)

  document FournisseurDocument @relation(fields: [id], references: [id], onDelete: Cascade)
  depot    Depot?              @relation(fields: [depotId], references: [id], onDelete: SetNull)

  bonRetourFournisseurs BonRetourFournisseur[]
  avoirFournisseurs     AvoirFournisseur[]
  payments              Payment[]
  stockTransactions     StockTransaction[]
  advances              BonReceptionAdvance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([depotId])
  @@index([documentReference])
  @@map("bon_receptions")
}

// ----------------------------------------
// BON RETOUR FOURNISSEUR (Return to Supplier)
// Workflow: BonReception -> BON_RETOUR_FOURNISSEUR -> AvoirFournisseur (optional)
// Stock:    RETURN_OUT — stock DECREASES at depotId (goods leave our depot)
// ----------------------------------------
model BonRetourFournisseur {
  id Int @id

  documentDate DateTime  @map("document_date") @db.Date
  depotId      Int?      @map("depot_id")  // Source depot — stock leaves here
  motifRetour  String?   @map("motif_retour") @db.VarChar(500)

  bonReceptionId Int?          @map("bon_reception_id")
  bonReception   BonReception? @relation(fields: [bonReceptionId], references: [id], onDelete: SetNull)

  document FournisseurDocument @relation(fields: [id], references: [id], onDelete: Cascade)
  depot    Depot?              @relation(fields: [depotId], references: [id], onDelete: SetNull)

  // Downstream — credit note(s) received from supplier following this return
  avoirFournisseurs AvoirFournisseur[]
  stockTransactions StockTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([bonReceptionId])
  @@index([depotId])
  @@map("bon_retour_fournisseurs")
}

// ----------------------------------------
// AVOIR FOURNISSEUR (Supplier Credit Note) — NEW
// Workflow: BonRetourFournisseur -> AVOIR_FOURNISSEUR  (return trigger)
//           BonReception -> AVOIR_FOURNISSEUR           (direct credit, no return)
// Stock:    NO stock impact — use BonRetourFournisseur for that
// Financial: triggers negative Payment (we receive credit/refund from supplier)
//
// An AvoirFournisseur can be:
//   a) Linked to a physical return — bonRetourFournisseurId set
//   b) Purely financial (price dispute, overcharge) — bonReceptionId only
//   c) Both
// ----------------------------------------
model AvoirFournisseur {
  id Int @id

  documentDate  DateTime       @map("document_date") @db.Date
  motif         String?        @db.VarChar(500)
  paymentMethod PaymentMethod? @map("payment_method")

  // Optional link to the physical return that triggered this credit
  bonRetourFournisseurId Int?                  @map("bon_retour_fournisseur_id")
  bonRetourFournisseur   BonRetourFournisseur? @relation(fields: [bonRetourFournisseurId], references: [id], onDelete: SetNull)

  // Optional direct link to the original reception (for non-return credits)
  bonReceptionId Int?          @map("bon_reception_id")
  bonReception   BonReception? @relation(fields: [bonReceptionId], references: [id], onDelete: SetNull)

  document FournisseurDocument @relation(fields: [id], references: [id], onDelete: Cascade)

  payments Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([documentDate])
  @@index([bonRetourFournisseurId])
  @@index([bonReceptionId])
  @@map("avoir_fournisseurs")
}

// ========================================
// PAYMENT
// Links only to financial settlement documents.
// Client:      Facture (received) or Avoir (refunded to client)
// Fournisseur: BonReception (paid) or AvoirFournisseur (received credit)
// ========================================

model Payment {
  id          Int         @id @default(autoincrement())
  paymentType PaymentType @map("payment_type")

  // Client side
  factureId Int? @map("facture_id")  // regular invoice payment
  avoirId   Int? @map("avoir_id")    // refund to client

  // Fournisseur side
  bonReceptionId       Int? @map("bon_reception_id")        // we pay supplier
  avoirFournisseurId   Int? @map("avoir_fournisseur_id")    // supplier credits us

  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @map("payment_method")
  paymentDate   DateTime      @map("payment_date") @db.Date
  reference     String?       @db.VarChar(100)
  bankAccount   String?       @map("bank_account") @db.VarChar(50)
  notes         String?       @db.Text

  facture          Facture?          @relation(fields: [factureId], references: [id], onDelete: Restrict)
  avoir            Avoir?            @relation(fields: [avoirId], references: [id], onDelete: Restrict)
  bonReception     BonReception?     @relation(fields: [bonReceptionId], references: [id], onDelete: Restrict)
  avoirFournisseur AvoirFournisseur? @relation(fields: [avoirFournisseurId], references: [id], onDelete: Restrict)

  createdBy Int?  @map("created_by")
  user      User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([factureId])
  @@index([avoirId])
  @@index([bonReceptionId])
  @@index([avoirFournisseurId])
  @@index([paymentDate])
  @@index([paymentType])
  @@index([createdBy])
  @@map("payments")
}

// ========================================
// STOCK TRANSACTION (Per Depot)
// ========================================

model StockTransaction {
  id              Int             @id @default(autoincrement())
  depotId         Int             @map("depot_id")
  articleId       Int?            @map("article_id")
  variantId       Int?            @map("variant_id")
  transactionType TransactionType @map("transaction_type")
  quantityChange  Decimal         @map("quantity_change") @db.Decimal(10, 3)
  quantityAfter   Decimal         @map("quantity_after") @db.Decimal(10, 3)
  // Purchase cost of this movement (BR line unitPrice, inventory PA, …).
  // Remaining stock is valued from these lots, not the catalog Article.prixAchat.
  unitCost        Decimal?        @map("unit_cost") @db.Decimal(10, 2)
  reason          String?         @db.Text
  referenceId     String?         @map("reference_id") @db.VarChar(100)
  createdBy       Int?            @map("created_by")

  // Source tracking — exactly one is set per transaction
  transferId             Int? @map("transfer_id")
  inventoryId            Int? @map("inventory_id")
  bonLivraisonId         Int? @map("bon_livraison_id")          // OUTBOUND
  bonRetourClientId      Int? @map("bon_retour_client_id")      // RETURN_IN
  bonReceptionId         Int? @map("bon_reception_id")          // INBOUND
  bonRetourFournisseurId Int? @map("bon_retour_fournisseur_id") // RETURN_OUT

  depot                Depot                 @relation(fields: [depotId], references: [id], onDelete: Restrict)
  article              Article?              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  variant              ArticleVariant?       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user                 User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  transfer             StockTransfer?        @relation(fields: [transferId], references: [id], onDelete: SetNull)
  inventory            Inventory?            @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  bonLivraison         BonLivraison?         @relation(fields: [bonLivraisonId], references: [id], onDelete: SetNull)
  bonRetourClient      BonRetourClient?      @relation(fields: [bonRetourClientId], references: [id], onDelete: SetNull)
  bonReception         BonReception?         @relation(fields: [bonReceptionId], references: [id], onDelete: SetNull)
  bonRetourFournisseur BonRetourFournisseur? @relation(fields: [bonRetourFournisseurId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([depotId])
  @@index([articleId])
  @@index([variantId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([createdBy])
  @@index([referenceId])
  @@index([transferId])
  @@index([inventoryId])
  @@index([bonLivraisonId])
  @@index([bonRetourClientId])
  @@index([bonReceptionId])
  @@index([bonRetourFournisseurId])
  @@map("stock_transactions")
}

// ========================================
// STOCK RESERVATION (Per Depot)
// ========================================

model StockReservation {
  id               Int               @id @default(autoincrement())
  depotId          Int               @map("depot_id")
  articleId        Int?              @map("article_id")
  variantId        Int?              @map("variant_id")
  orderId          String            @map("order_id") @db.VarChar(100)
  quantityReserved Decimal           @map("quantity_reserved") @db.Decimal(10, 3)
  status           ReservationStatus @default(PENDING)
  expiresAt        DateTime?         @map("expires_at")

  depot   Depot           @relation(fields: [depotId], references: [id], onDelete: Restrict)
  article Article?        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  variant ArticleVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([depotId])
  @@index([articleId])
  @@index([variantId])
  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
  @@map("stock_reservations")
}

// ========================================
// STOCK TRANSFER (Between Depots)
// ========================================

model StockTransfer {
  id             Int    @id @default(autoincrement())
  societeId      Int    @map("societe_id")
  transferNumber String @map("transfer_number") @db.VarChar(50)

  sourceDepotId      Int @map("source_depot_id")
  destinationDepotId Int @map("destination_depot_id")

  transferDate DateTime       @map("transfer_date") @db.Date
  status       TransferStatus @default(PENDING)
  notes        String?        @db.Text

  createdBy   Int?      @map("created_by")
  validatedBy Int?      @map("validated_by")
  validatedAt DateTime? @map("validated_at")

  societe          Societe             @relation(fields: [societeId], references: [id], onDelete: Cascade)
  sourceDepot      Depot               @relation("SourceDepot", fields: [sourceDepotId], references: [id], onDelete: Restrict)
  destinationDepot Depot               @relation("DestinationDepot", fields: [destinationDepotId], references: [id], onDelete: Restrict)
  lines            StockTransferLine[]
  transactions     StockTransaction[]
  createdByUser    User?               @relation("TransferCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  validatedByUser  User?               @relation("TransferValidatedBy", fields: [validatedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([societeId, transferNumber])
  @@index([societeId])
  @@index([sourceDepotId])
  @@index([destinationDepotId])
  @@index([status])
  @@index([transferDate])
  @@index([createdBy])
  @@map("stock_transfers")
}

// ========================================
// STOCK TRANSFER LINE
// ========================================

model StockTransferLine {
  id         Int  @id @default(autoincrement())
  transferId Int  @map("transfer_id")
  articleId  Int? @map("article_id")
  variantId  Int? @map("variant_id")

  lineNumber       Int     @map("line_number")
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(10, 3)

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  article  Article?        @relation(fields: [articleId], references: [id], onDelete: Restrict)
  variant  ArticleVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([transferId, lineNumber])
  @@unique([transferId, articleId])
  @@unique([transferId, variantId])
  @@index([transferId])
  @@index([articleId])
  @@index([variantId])
  @@map("stock_transfer_lines")
}

// ========================================
// INVENTORY (Physical Stock Count)
// ========================================

model Inventory {
  id              Int      @id @default(autoincrement())
  societeId       Int      @map("societe_id")
  depotId         Int      @map("depot_id")
  inventoryNumber String   @map("inventory_number") @db.VarChar(50)
  inventoryDate   DateTime @map("inventory_date") @db.Date
  notes           String?  @db.Text
  gap             Decimal  @default(0) @db.Decimal(10, 2)

  createdBy   Int?      @map("created_by")
  validatedBy Int?      @map("validated_by")
  validatedAt DateTime? @map("validated_at")

  societe         Societe            @relation(fields: [societeId], references: [id], onDelete: Cascade)
  depot           Depot              @relation(fields: [depotId], references: [id], onDelete: Restrict)
  lines           InventoryLine[]
  transactions    StockTransaction[]
  createdByUser   User?              @relation("InventoryCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  validatedByUser User?              @relation("InventoryValidatedBy", fields: [validatedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([societeId, inventoryNumber])
  @@index([societeId])
  @@index([depotId])
  @@index([inventoryDate])
  @@index([createdBy])
  @@map("inventories")
}

// ========================================
// INVENTORY LINE
// ========================================

model InventoryLine {
  id          Int  @id @default(autoincrement())
  inventoryId Int  @map("inventory_id")
  articleId   Int? @map("article_id")
  variantId   Int? @map("variant_id")

  lineNumber          Int     @map("line_number")
  quantityTheoretical Decimal @map("quantity_theoretical") @db.Decimal(10, 3)
  quantityCounted     Decimal @map("quantity_counted") @db.Decimal(10, 3)
  quantityDifference  Decimal @map("quantity_difference") @db.Decimal(10, 3)

  inventory Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  article   Article?        @relation(fields: [articleId], references: [id], onDelete: Restrict)
  variant   ArticleVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([inventoryId, lineNumber])
  @@unique([inventoryId, articleId])
  @@unique([inventoryId, variantId])
  @@index([inventoryId])
  @@index([articleId])
  @@index([variantId])
  @@map("inventory_lines")
}

// ========================================
// REGLEMENT CLIENT (Client Payment)
// ========================================

model ReglementClient {
  id               Int           @id @default(autoincrement())
  societeId        Int           @map("societe_id")
  date             DateTime       @db.DateTime
  clientId         Int           @map("client_id")
  modeReglement    ModeReglement @map("mode_reglement")
  documentNumbers  Json?         @map("document_numbers")   // String[] — BonLivraison documentNumbers
  paymentBreakdown Json?         @map("payment_breakdown")  // {docNumber: amountApplied} for rollback
  montantRegle     Decimal       @map("montant_regle") @db.Decimal(10, 2)
  montantBL        Decimal       @default(0) @map("montant_bl") @db.Decimal(10, 2)
  solde            Decimal       @db.Decimal(10, 2)
  refDocument      String?       @map("ref_document") @db.VarChar(255)
  dateEcheance     DateTime?     @map("date_echeance") @db.Date
  banqueId         Int?          @map("banque_id")

  // Reference to an advance (avance) used in this payment
  avanceId       Int?     @map("avance_id")
  avanceConsumed Decimal? @map("avance_consumed") @db.Decimal(10, 2)

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  banque  Banque? @relation(fields: [banqueId], references: [id], onDelete: SetNull)

  avance     ReglementClient?  @relation("AvanceConsumption", fields: [avanceId], references: [id], onDelete: SetNull)
  consumedBy ReglementClient[] @relation("AvanceConsumption")

  bonLivraisonAdvances BonLivraisonAdvance[]
  caisseTransactions   CaisseTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([societeId])
  @@index([clientId])
  @@index([date])
  @@index([banqueId])
  @@index([avanceId])
  @@map("reglement_clients")
}

// ========================================
// REGLEMENT FOURNISSEUR (Supplier Payment)
// Mirror of ReglementClient, operating on Fournisseurs and
// BonReception-backed FournisseurDocuments instead of Clients
// and BonLivraison-backed ClientDocuments.
// ========================================

model ReglementFournisseur {
  id               Int           @id @default(autoincrement())
  societeId        Int           @map("societe_id")
  date             DateTime       @db.DateTime
  fournisseurId    Int           @map("fournisseur_id")
  modeReglement    ModeReglement @map("mode_reglement")
  documentNumbers  Json?         @map("document_numbers")   // String[] — BonReception documentNumbers
  paymentBreakdown Json?         @map("payment_breakdown")  // {docNumber: amountApplied} for rollback
  montantRegle     Decimal       @map("montant_regle") @db.Decimal(10, 2)
  montantBR        Decimal       @default(0) @map("montant_br") @db.Decimal(10, 2)
  solde            Decimal       @db.Decimal(10, 2)
  refDocument      String?       @map("ref_document") @db.VarChar(255)
  dateEcheance     DateTime?     @map("date_echeance") @db.Date
  banqueId         Int?          @map("banque_id")

  // Reference to an advance (avance) used in this payment
  avanceId       Int?     @map("avance_id")
  avanceConsumed Decimal? @map("avance_consumed") @db.Decimal(10, 2)

  societe     Societe     @relation(fields: [societeId], references: [id], onDelete: Cascade)
  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Restrict)
  banque      Banque?     @relation(fields: [banqueId], references: [id], onDelete: SetNull)

  avance     ReglementFournisseur?  @relation("AvanceConsumptionFournisseur", fields: [avanceId], references: [id], onDelete: SetNull)
  consumedBy ReglementFournisseur[] @relation("AvanceConsumptionFournisseur")

  bonReceptionAdvances BonReceptionAdvance[]
  caisseTransactions   CaisseTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([societeId])
  @@index([fournisseurId])
  @@index([date])
  @@index([banqueId])
  @@index([avanceId])
  @@map("reglement_fournisseurs")
}

// ----------------------------------------
// BON RECEPTION ADVANCE (join table)
// Mirror of BonLivraisonAdvance — tracks supplier advances
// (ReglementFournisseur with montantBR = 0) applied to a
// specific BonReception, enabling precise rollback on removal.
// ----------------------------------------
model BonReceptionAdvance {
  id             Int     @id @default(autoincrement())
  bonReceptionId Int     @map("bon_reception_id")
  advanceId      Int     @map("advance_id")
  amountApplied  Decimal @map("amount_applied") @db.Decimal(10, 2)

  bonReception BonReception         @relation(fields: [bonReceptionId], references: [id], onDelete: Cascade)
  advance      ReglementFournisseur @relation(fields: [advanceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([bonReceptionId, advanceId])
  @@index([advanceId])
  @@map("bon_reception_advances")
}

// ========================================
// GESTION DE CAISSE
// ========================================

model CaisseLabel {
  id     Int     @id @default(autoincrement())
  name   String  @unique @db.VarChar(100)
  active Boolean @default(true)

  transactions CaisseTransaction[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@map("caisse_labels")
}

model Caisse {
  id             Int        @id @default(autoincrement())
  userId         Int?       @unique @map("user_id")
  societeId      Int?       @map("societe_id")
  banqueId       Int?       @map("banque_id")
  caisseType     CaisseType @map("caisse_type")
  name           String     @db.VarChar(255)
  initialBalance Decimal    @default(0) @map("initial_balance") @db.Decimal(10, 2)
  currentBalance Decimal    @default(0) @map("current_balance") @db.Decimal(10, 2)
  active         Boolean    @default(true)
  createdById    Int?       @map("created_by_id")

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  societe   Societe? @relation(fields: [societeId], references: [id], onDelete: Cascade)
  banque    Banque?  @relation(fields: [banqueId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CaisseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  transactions           CaisseTransaction[] @relation("OwnerCaisse")
  referencedTransactions CaisseTransaction[] @relation("ReferenceCaisse")
  outgoingTransferRequests CaisseTransferRequest[] @relation("TransferRequestSource")
  incomingTransferRequests CaisseTransferRequest[] @relation("TransferRequestDest")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([societeId, banqueId])
  @@index([societeId])
  @@index([banqueId])
  @@index([caisseType])
  @@index([active])
  @@index([createdById])
  @@map("caisses")
}

model CaisseTransaction {
  id                     Int                   @id @default(autoincrement())
  caisseId               Int                   @map("caisse_id")
  transactionType        CaisseTransactionType @map("transaction_type")
  labelId                Int?                  @map("label_id")
  amount                 Decimal               @db.Decimal(10, 2)
  oldBalance             Decimal               @map("old_balance") @db.Decimal(10, 2)
  newBalance             Decimal               @map("new_balance") @db.Decimal(10, 2)
  note                   String?               @db.Text
  referenceCaisseId      Int?                  @map("reference_caisse_id")
  reglementClientId      Int?                  @map("reglement_client_id")
  reglementFournisseurId Int?                  @map("reglement_fournisseur_id")
  createdBy              Int?                  @map("created_by")
  createdAt              DateTime              @default(now()) @map("created_at")

  caisse               Caisse                @relation("OwnerCaisse", fields: [caisseId], references: [id], onDelete: Cascade)
  label                CaisseLabel?          @relation(fields: [labelId], references: [id], onDelete: SetNull)
  referenceCaisse      Caisse?               @relation("ReferenceCaisse", fields: [referenceCaisseId], references: [id], onDelete: SetNull)
  reglementClient      ReglementClient?      @relation(fields: [reglementClientId], references: [id], onDelete: SetNull)
  reglementFournisseur ReglementFournisseur? @relation(fields: [reglementFournisseurId], references: [id], onDelete: SetNull)
  creator              User?                 @relation("CaisseTransactionCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([caisseId])
  @@index([transactionType])
  @@index([labelId])
  @@index([createdAt])
  @@index([createdBy])
  @@index([referenceCaisseId])
  @@index([reglementClientId])
  @@index([reglementFournisseurId])
  @@map("caisse_transactions")
}

model CaisseTransferRequest {
  id                  Int                  @id @default(autoincrement())
  sourceCaisseId      Int                  @map("source_caisse_id")
  destinationCaisseId Int                  @map("destination_caisse_id")
  amount              Decimal              @db.Decimal(10, 2)
  note                String?              @db.Text
  status              CaisseTransferStatus @default(PENDING)
  requiresSuperAdmin  Boolean              @default(false) @map("requires_super_admin")
  createdById         Int                  @map("created_by_id")
  respondedById       Int?                 @map("responded_by_id")
  respondedAt         DateTime?            @map("responded_at")

  sourceCaisse      Caisse @relation("TransferRequestSource", fields: [sourceCaisseId], references: [id], onDelete: Cascade)
  destinationCaisse Caisse @relation("TransferRequestDest", fields: [destinationCaisseId], references: [id], onDelete: Cascade)
  createdBy         User   @relation("TransferRequestCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  respondedBy       User?  @relation("TransferRequestRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  notifications     Notification[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([sourceCaisseId])
  @@index([destinationCaisseId])
  @@index([createdById])
  @@index([requiresSuperAdmin])
  @@map("caisse_transfer_requests")
}

model Notification {
  id                Int              @id @default(autoincrement())
  userId            Int              @map("user_id")
  type              NotificationType
  payload           Json?
  read              Boolean          @default(false)
  transferRequestId Int?             @map("transfer_request_id")

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transferRequest CaisseTransferRequest? @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([transferRequestId])
  @@map("notifications")
}

// ========================================
// ATTENDANCE (ZKTeco punch logs imported via attendance-link)
// ========================================

model AttendanceRecord {
  id           Int      @id @default(autoincrement())
  societeId    Int      @map("societe_id")
  userId       Int      @map("user_id")
  deviceUserId String   @map("device_user_id") @db.VarChar(50)
  deviceUid    Int?     @map("device_uid")
  punchTime    DateTime @map("punch_time")
  punchType    Int      @default(0) @map("punch_type")
  verifyMode   Int?     @map("verify_mode")
  deviceIp     String   @default("") @map("device_ip") @db.VarChar(64)
  deviceSn     String?  @map("device_sn") @db.VarChar(64)
  importedAt   DateTime @default(now()) @map("imported_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@unique([societeId, deviceIp, deviceUserId, punchTime], name: "attendance_dedup")
  @@index([societeId, punchTime])
  @@index([userId, punchTime])
  @@index([importedAt])
  @@map("attendance_records")
}
