// ========================================
// COMPLETE PRISMA SCHEMA - MULTI-SOCIÉTÉ MULTI-DÉPÔT ERP
// Version: 6.0 - FULL RETURN DOCUMENT ARCHITECTURE
// Last Updated: March 2026
// Total Models: 44
// ========================================
//
// Architecture: Generic Header + Specialized Extension Tables
//
// KEY PRINCIPLE — Physical movement != Financial adjustment:
//   Every return scenario splits into two independent documents:
//     1. Physical document  — moves stock (INBOUND or OUTBOUND)
//     2. Financial document — adjusts accounting (credit note)
//   They link optionally; either can exist without the other.
//
// Document Family A — Client (Sales):
//   ClientDocument (header)
//     |- Devis                (quote)
//     |- Commande             (sales order)
//     |- BonLivraison         (delivery note       — OUTBOUND stock)
//     |- BonRetourClient      (client return note  — RETURN_IN stock, goods come back)
//     |- Facture              (invoice             — triggers payment received)
//     +- Avoir                (credit note         — financial credit to client,
//                                                    optionally linked to BonRetourClient)
//
// Document Family B — Fournisseur (Purchases):
//   FournisseurDocument (header)
//     |- CommandeFournisseur   (purchase order       — no stock, quantities only)
//     |- BonReception          (goods receipt        — INBOUND stock)
//     |- BonRetourFournisseur  (return to supplier   — RETURN_OUT stock, goods leave)
//     +- AvoirFournisseur      (supplier credit note — financial credit from supplier,
//                                                      optionally linked to BonRetourFournisseur)
//
// Lines:
//   ClientDocumentLine      — articles/variants on client documents
//   FournisseurDocumentLine — articles/variants on fournisseur documents
//
// Workflow chains:
//   Sales:    Devis -> Commande -> BonLivraison -> Facture
//                                      | (if return)
//                               BonRetourClient -> Avoir (credit)
//
//   Purchase: CommandeFournisseur -> BonReception (goods arrive)
//                                       | (if return)
//                                  BonRetourFournisseur -> AvoirFournisseur (credit from supplier)
//
// Stock impact summary:
//   BonLivraison         -> OUTBOUND    (stock decreases at depot)
//   BonRetourClient      -> RETURN_IN   (stock increases at depot, goods come back)
//   BonReception         -> INBOUND     (stock increases at depot)
//   BonRetourFournisseur -> RETURN_OUT  (stock decreases at depot, goods leave)
//   Avoir                -> no stock impact (financial only)
//   AvoirFournisseur     -> no stock impact (financial only)
//
// ========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ========================================
// ENUMS
// ========================================

enum DepotType {
  PRINCIPAL
  SECONDARY
  OUTLET
  TRANSIT
}

enum TransactionType {
  INBOUND      // BonReception validated — stock arrives from supplier
  OUTBOUND     // BonLivraison validated — stock leaves to client
  RETURN_IN    // BonRetourClient — client returns goods, stock comes back IN
  RETURN_OUT   // BonRetourFournisseur — we return goods to supplier, stock goes OUT
  ADJUSTMENT   // Inventory correction
  TRANSFER_OUT // StockTransfer — leaves source depot
  TRANSFER_IN  // StockTransfer — arrives at destination depot
  DAMAGED      // Write-off
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum EntityType {
  PARTICULIER
  SOCIETE
}

enum DeliveryType {
  INTERN
  EXTERN
}

enum DocumentStatus {
  DRAFT      // Brouillon — editable, no impact
  CONFIRMED  // Confirme  — locked, awaiting execution
  PARTIAL    // Partiel   — partially executed
  COMPLETED  // Complete  — fully executed
  CANCELLED  // Annule    — voided
  PAID       // Paye      — financial settlement complete
}

enum PaymentMethod {
  ESPECES
  CHEQUE
  VIREMENT
  CARTE
  TRAITE
  EFFET
}

enum PaymentType {
  CLIENT       // Payment received from client
  FOURNISSEUR  // Payment sent to supplier
}

enum TransferStatus {
  PENDING
  COMPLETED
}

enum ModeReglement {
  ESPECE
  CARTE_BANCAIRE
  CHEQUE
  EFFET
  CARTE_FIDELITE
  BON_ACHAT
  REMISE
  VIREMENT
}

enum BonLivraisonType {
  STANDARD
  ADVANCED
}

// ----------------------------------------
// DELIVERY PROVIDER CONFIG (per-société, per-business-entity)
// Stores encrypted credentials for external delivery providers.
// One société can have multiple configs for the same provider
// (e.g. two Ameex accounts for different business entities).
// ----------------------------------------
model DeliveryProviderConfig {
  id        Int     @id @default(autoincrement())
  societeId Int     @map("societe_id")
  provider  String  @db.VarChar(50)   // "AMEEX", "AMANA", …
  name      String  @db.VarChar(100)  // display label in picker
  apiId     String  @map("api_id")    @db.VarChar(255) // AES-256-GCM encrypted
  apiKey    String  @map("api_key")   @db.VarChar(255) // AES-256-GCM encrypted
  active    Boolean @default(true)
  metadata  Json?

  societe       Societe        @relation(fields: [societeId], references: [id], onDelete: Cascade)
  bonLivraisons BonLivraison[] @relation("BLProviderConfig")

  @@index([societeId, provider])
  @@index([active])
  @@map("delivery_provider_configs")
}

enum WebhookLogStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ColisSync {
  NOT_APPLICABLE
  PENDING
  CREATED
  FAILED
  RECEIVED
}

enum BonLivraisonStatus {
  EN_COURS
  CONFIRME
  PREPARE
  COLLECTE
  EN_ROUTE
  LIVRE
  ANNULE
  REPORTE
  PAYE
  UPDATE
  SUSPENDED
  CONTINUED
}

enum CaisseType {
  USER
  BANK
  CAISSE
}

enum CaisseTransactionType {
  INITIAL_BALANCE
  CHARGE
  TRANSFER_IN
  TRANSFER_OUT
  INCOME
  EXPENSE
}

enum CaisseTransferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  WALLET_TRANSFER_REQUEST
  WALLET_TRANSFER_ACCEPTED
  WALLET_TRANSFER_DECLINED
}

// ========================================
// SOCIETE (Core Multi-Tenancy)
// ========================================

model Societe {
  id           Int     @id @default(autoincrement())
  raisonSocial String  @map("raison_social") @db.VarChar(255)
  logo         String? @db.Text

  address String? @db.Text
  tel     String? @db.VarChar(20)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(100)
  siteWeb String? @map("site_web") @db.VarChar(255)

  ice String? @unique @db.VarChar(15)
  rc  String? @db.VarChar(20)
  tp  String? @db.VarChar(20)
  if  String? @db.VarChar(20)

  fixedStructure Json? @map("fixed_structure")

  /// PDF / printable document header branding (colors, logo, layout)
  documentHeaderConfig Json? @map("document_header_config")

  depots               Depot[]
  users                User[]
  clients              Client[]
  fournisseurs         Fournisseur[]
  deliveries           Delivery[]
  clientDocuments      ClientDocument[]
  fournisseurDocuments FournisseurDocument[]
  societePricing       SocietePricing[]
  stockTransfers       StockTransfer[]
  inventories          Inventory[]
  reglements           ReglementClient[]
  reglementsFournisseur ReglementFournisseur[]
  agences              Agence[]
  packs                Pack[]
  deliveryProviderConfigs DeliveryProviderConfig[]
  caisses                 Caisse[]
  attendanceRecords       AttendanceRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ice])
  @@map("societes")
}

// ========================================
// DEPOT
// ========================================

model Depot {
  id        Int    @id @default(autoincrement())
  societeId Int    @map("societe_id")
  code      String @db.VarChar(20)
  name      String @db.VarChar(255)

  address String? @db.Text
  city    String? @db.VarChar(100)
  region  String? @db.VarChar(100)
  phone   String? @db.VarChar(20)
  email   String? @db.VarChar(100)
  manager String? @db.VarChar(255)

  type     DepotType @default(PRINCIPAL)
  surface  Decimal?  @db.Decimal(10, 2)
  capacity Decimal?  @db.Decimal(10, 2)
  active   Boolean   @default(true)

  societe                Societe               @relation(fields: [societeId], references: [id], onDelete: Cascade)
  stockByDepot           StockByDepot[]
  stockTransactions      StockTransaction[]
  stockReservations      StockReservation[]
  transfersAsSource      StockTransfer[]       @relation("SourceDepot")
  transfersAsDestination StockTransfer[]       @relation("DestinationDepot")
  inventories            Inventory[]
  // Stock-movement documents only — these are the only doc types that touch a depot
  bonLivraisons          BonLivraison[]
  bonRetourClients       BonRetourClient[]
  bonReceptions          BonReception[]
  bonRetourFournisseurs  BonRetourFournisseur[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([societeId, code])
  @@index([societeId])
  @@index([active])
  @@index([type])
  @@map("depots")
}

// ========================================
// STOCK BY DEPOT
// ========================================

model StockByDepot {
  id        Int  @id @default(autoincrement())
  depotId   Int  @map("depot_id")
  articleId Int? @map("article_id")
  variantId Int? @map("variant_id")

  quantityAvailable Decimal   @default(0) @map("quantity_available") @db.Decimal(10, 3)
  quantityReserved  Decimal   @default(0) @map("quantity_reserved") @db.Decimal(10, 3)
  quantityInTransit Decimal   @default(0) @map("quantity_in_transit") @db.Decimal(10, 3)
  alertThreshold    Decimal   @default(0) @map("alert_threshold") @db.Decimal(10, 3)
  location          String?   @db.VarChar(50)
  lastInventoryDate DateTime? @map("last_inventory_date")

  depot   Depot           @relation(fields: [depotId], references: [id], onDelete: Cascade)
  article Article?        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  variant ArticleVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([depotId, articleId])
  @@unique([depotId, variantId])
  @@index([depotId])
  @@index([articleId])
  @@index([variantId])
  @@index([quantityAvailable])
  @@map("stock_by_depot")
}

// ========================================
// SYSTEM SETTINGS
// ========================================

model SystemSettings {
  id                 Int     @id @default(autoincrement())
  allowNegativeStock Boolean @default(false)
  systemStartHour    Int?
  systemEndHour      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ========================================
// SETTINGS CHANGE LOG
// ========================================

model SettingsChangeLog {
  id          Int      @id @default(autoincrement())
  settingName String   @db.VarChar(100)
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  changedBy   Int
  reason      String?  @db.VarChar(500)
  changedAt   DateTime @default(now())

  user User @relation(fields: [changedBy], references: [id])

  @@index([settingName])
  @@index([changedAt])
  @@map("settings_change_log")
}

// ========================================
// USER
// ========================================

model User {
  id           Int     @id @default(autoincrement())
  societeId    Int?    @map("societe_id")
  email        String  @unique
  name         String
  password     String
  isSuperAdmin Boolean @default(false) @map("is_super_admin")
  profile      String?
  active       Boolean @default(true)

  // Extra operational roles for order assignment (independent of main roleId)
  canBePreparateur Boolean @default(false) @map("can_be_preparateur")
  canBeLivreur     Boolean @default(false) @map("can_be_livreur")

  roleId Int  @map("role_id")
  role   Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  extraPermissions   UserExtraPermission[]
  removedPermissions UserRemovedPermission[]
  settingsChanges    SettingsChangeLog[]

  societe              Societe?  @relation(fields: [societeId], references: [id], onDelete: Cascade)
  stockTransactions    StockTransaction[]
  payments             Payment[]
  createdTransfers     StockTransfer[] @relation("TransferCreatedBy")
  validatedTransfers   StockTransfer[] @relation("TransferValidatedBy")
  createdInventories   Inventory[]     @relation("InventoryCreatedBy")
  validatedInventories Inventory[]     @relation("InventoryValidatedBy")

  createdClientDocuments      ClientDocument[]      @relation("ClientDocCreatedBy")
  createdFournisseurDocuments FournisseurDocument[] @relation("FournisseurDocCreatedBy")

  // Advanced BonLivraison assignment back-references
  commercialBLs   BonLivraison[] @relation("BLCommercial")
  preparateurBLs  BonLivraison[] @relation("BLPreparateur")
  reportedBLs     BonLivraison[] @relation("BLReportedBy")

  // Status transitions performed by this user
  blStatusHistory BonLivraisonStatusHistory[] @relation("BLStatusHistoryUser")

  // Linked Delivery (operational identity) for INTERN livreur users
  delivery Delivery?

  // Caisse (cash register)
  caisse             Caisse?
  caissesCreated     Caisse[]            @relation("CaisseCreatedBy")
  caisseTransactions CaisseTransaction[] @relation("CaisseTransactionCreatedBy")
  notifications               Notification[]
  createdTransferRequests     CaisseTransferRequest[] @relation("TransferRequestCreatedBy")
  respondedTransferRequests   CaisseTransferRequest[] @relation("TransferRequestRespondedBy")
  attendanceRecords           AttendanceRecord[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([email])
  @@index([societeId])
  @@index([isSuperAdmin])
  @@index([canBePreparateur])
  @@index([canBeLivreur])
  @@map("users")
}

// ========================================
// RBAC
// ========================================

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users           User[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id   Int    @id @default(autoincrement())
  name String @unique

  rolePermissions  RolePermission[]
  extraForUsers    UserExtraPermission[]
  removedFromUsers UserRemovedPermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserExtraPermission {
  userId       Int @map("user_id")
  permissionId Int @map("permission_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_extra_permissions")
}

model UserRemovedPermission {
  userId       Int @map("user_id")
  permissionId Int @map("permission_id")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
  @@map("user_removed_permissions")
}

// ========================================
// CATEGORY / FAMILY / UNIT (GLOBAL)
// ========================================

model Category {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  image    String? @db.Text
  visible  Boolean @default(true)
  afficher Json?

  families Family[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([visible])
  @@map("categories")
}

model Family {
  id            Int      @id @default(autoincrement())
  categoryId    Int      @map("category_id")
  name          String   @unique
  manageInStock Boolean  @default(false) @map("manage_in_stock")
  TVA           Decimal  @db.Decimal(10, 2)
  image         String?  @db.Text
  visible       Boolean  @default(true)
  afficher      Json?
  remise        Decimal? @db.Decimal(10, 2)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([visible])
  @@map("families")
}

model Unit {
  id               Int     @id @default(autoincrement())
  name             String  @unique @db.VarChar(50)
  symbol           String  @db.VarChar(10)
  allowsFractional Boolean @default(false) @map("allows_fractional")

  articlesAsPrincipale     Article[] @relation("ArticleUnitPrincipale")
  articlesAsSecondaire     Article[] @relation("ArticleUnitSecondaire")
  articlesAsComplementaire Article[] @relation("ArticleUnitComplementaire")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("units")
}

// ========================================
// ATTRIBUTE / ATTRIBUTE VALUE (GLOBAL)
// ========================================

model Attribute {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  values            AttributeValue[]
  variantAttributes VariantAttribute[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("attributes")
}

model AttributeValue {
  id          Int    @id @default(autoincrement())
  attributeId Int    @map("attribute_id")
  value       String @db.VarChar(100)

  attribute         Attribute          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantAttributes VariantAttribute[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([attributeId, value])
  @@index([attributeId])
  @@map("attribute_values")
}

// ========================================
// ARTICLE (GLOBAL)
// ========================================

model Article {
  id       Int     @id @default(autoincrement())
  familyId Int     @map("family_id")
  barcode  String  @unique @db.VarChar(50)
  name     String  @db.VarChar(255)
  image    String? @db.Text
  visible  Boolean @default(true)

  gereEnStock Boolean @default(true) @map("gere_en_stock")

  unitePrincipaleId     Int  @map("unite_principale_id")
  uniteSecondaireId     Int? @map("unite_secondaire_id")
  uniteComplementaireId Int? @map("unite_complementaire_id")

  unitePrincipale     Unit  @relation("ArticleUnitPrincipale", fields: [unitePrincipaleId], references: [id], onDelete: Restrict)
  uniteSecondaire     Unit? @relation("ArticleUnitSecondaire", fields: [uniteSecondaireId], references: [id], onDelete: Restrict)
  uniteComplementaire Unit? @relation("ArticleUnitComplementaire", fields: [uniteComplementaireId], references: [id], onDelete: Restrict)

  conversionSecondaire     Decimal? @map("conversion_secondaire") @db.Decimal(10, 4)
  conversionComplementaire Decimal? @map("conversion_complementaire") @db.Decimal(10, 4)

  prixAchat  Decimal @map("prix_achat") @db.Decimal(10, 2)
  prixVente1 Decimal @map("prix_vente_1") @db.Decimal(10, 2)
  prixVente2 Decimal @map("prix_vente_2") @db.Decimal(10, 2)
  prixVente3 Decimal @map("prix_vente_3") @db.Decimal(10, 2)
  commission Decimal @default(0) @db.Decimal(10, 2)

  dateExpiration  DateTime? @map("date_expiration") @db.Date
  dureeExpiration String?   @map("duree_expiration") @db.VarChar(50)
  remise          Decimal?  @db.Decimal(5, 2)

  family                   Family                     @relation(fields: [familyId], references: [id], onDelete: Restrict)
  variants                 ArticleVariant[]
  stockByDepot             StockByDepot[]
  transactions             StockTransaction[]
  reservations             StockReservation[]
  societePricing           SocietePricing[]
  transferLines            StockTransferLine[]
  inventoryLines           InventoryLine[]
  clientDocumentLines      ClientDocumentLine[]
  fournisseurDocumentLines FournisseurDocumentLine[]
  packComponents           PackComponent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([familyId])
  @@index([barcode])
  @@index([gereEnStock])
  @@index([unitePrincipaleId])
  @@index([visible])
  @@map("articles")
}

// ========================================
// ARTICLE VARIANT (GLOBAL)
// ========================================

model ArticleVariant {
  id        Int    @id @default(autoincrement())
  articleId Int    @map("article_id")
  barcode   String @unique @db.VarChar(50)
  name      String @db.VarChar(255)

  article                  Article                    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  variantAttributes        VariantAttribute[]
  stockByDepot             StockByDepot[]
  transactions             StockTransaction[]
  reservations             StockReservation[]
  societePricing           SocietePricing[]
  transferLines            StockTransferLine[]
  inventoryLines           InventoryLine[]
  clientDocumentLines      ClientDocumentLine[]
  fournisseurDocumentLines FournisseurDocumentLine[]
  packComponents           PackComponent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([articleId])
  @@index([barcode])
  @@map("article_variants")
}

// ========================================
// VARIANT ATTRIBUTE (GLOBAL)
// ========================================

model VariantAttribute {
  variantId        Int @map("variant_id")
  attributeId      Int @map("attribute_id")
  attributeValueId Int @map("attribute_value_id")

  variant        ArticleVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([variantId, attributeId])
  @@index([attributeId])
  @@index([attributeValueId])
  @@map("variant_attributes")
}

// ========================================
// SOCIETE PRICING
// ========================================

model SocietePricing {
  id        Int  @id @default(autoincrement())
  societeId Int  @map("societe_id")
  articleId Int? @map("article_id")
  variantId Int? @map("variant_id")

  prixAchat  Decimal? @map("prix_achat") @db.Decimal(10, 2)
  prixVente1 Decimal? @map("prix_vente_1") @db.Decimal(10, 2)
  prixVente2 Decimal? @map("prix_vente_2") @db.Decimal(10, 2)
  prixVente3 Decimal? @map("prix_vente_3") @db.Decimal(10, 2)
  remise     Decimal? @db.Decimal(5, 2)
  active     Boolean  @default(true)

  societe Societe         @relation(fields: [societeId], references: [id], onDelete: Cascade)
  article Article?        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  variant ArticleVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([societeId, articleId])
  @@unique([societeId, variantId])
  @@index([societeId])
  @@index([articleId])
  @@index([variantId])
  @@index([active])
  @@map("societe_pricing")
}

// ========================================
// CLIENT (PER SOCIETE)
// ========================================

model Client {
  id        Int @id @default(autoincrement())
  societeId Int @map("societe_id")

  name    String     @db.VarChar(255)
  type    EntityType @default(PARTICULIER)
  address String?    @db.Text
  city    String?    @db.VarChar(100)
  region  String?    @db.VarChar(100)
  phone   String?    @db.VarChar(20)
  email   String?    @db.VarChar(100)
  website String?    @db.VarChar(255)

  ice String? @db.VarChar(15)
  if  String? @db.VarChar(20)
  rc  String? @db.VarChar(20)
  tp  String? @db.VarChar(20)

  creditLimit     Decimal? @map("credit_limit") @db.Decimal(10, 2)
  paymentDeadline Int?     @map("payment_deadline")
  discount        Decimal? @db.Decimal(5, 2)
  active          Boolean  @default(true)
  isSystem        Boolean  @default(false) @map("is_system")

  societe    Societe           @relation(fields: [societeId], references: [id], onDelete: Cascade)
  documents  ClientDocument[]
  reglements ReglementClient[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([societeId, phone])
  @@unique([societeId, ice])
  @@index([societeId])
  @@index([name])
  @@index([active])
  @@index([type])
  @@map("clients")
}

