PORT=3000
BASE_URL=http://localhost:3000
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/saphirDB"

NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# JWT — generate long random strings for production
ACCESS_TOKEN_SECRET=change-me-access-token-secret
REFRESH_TOKEN_SECRET=change-me-refresh-token-secret
REFRESH_TOKEN_EXPIRY="7d"
JWT_SECRET=change-me-jwt-secret
ACCESS_TOKEN_EXPIRY=30m

# 32-byte hex key for encrypting stored credentials
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-chars

# Optional — Ameex delivery integration
AMEEX_API_URL=https://api.ameex.app
AMEEX_API_ID=
AMEEX_API_KEY=

# Optional — transactional email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
